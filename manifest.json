{
  "manifest_version": 3,
  "name": "Plane Notification - Archive Duplicates",
  "version": "2.4",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://plane.ageno.work/*"],
      "js": ["filterGroup.js", "features/workspacesNotificationCounter.js"],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["template.html","features/generateTaskDescription.js"],
      "matches": ["https://plane.ageno.work/*"]
    }
  ]
}
